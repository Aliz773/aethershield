# The hev-socks5-tunnel JNI_OnLoad does FindClass("hev/htproxy/TProxyService") and
# RegisterNatives on it. Renaming this class breaks the native bridge silently.
-keep class hev.htproxy.TProxyService { *; }

# Anything else reached only from native code.
-keepclasseswithmembernames class * {
    native <methods>;
}
